# Copy to .env.local and adjust. Every variable of src/config/env.schema.ts is declared here;
# pnpm validate:env fails when the two drift apart.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=replace-this-with-a-long-random-admin-api-key
METRICS_TOKEN=replace-this-with-a-random-metrics-token
