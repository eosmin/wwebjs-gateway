+    // WhatsApp Web opens a short-lived iframe (webtp.whatsapp.net/pdf-viewer) right after
+    // authentication. exposeFunction also registers the binding in that iframe, so when it closes
+    // mid-call Puppeteer rejects with 'Target closed' although the main frame already has the
+    // binding. The check below sees it on the next pass; without a retry the ready event never
+    // fires.
+    const maxAttempts = 5;
+    for (let attempt = 1; ; attempt++) {
+        const exist = await page.evaluate((name) => {
+            return !!window[name];
+        }, name);
+        if (exist) {
+            return;
+        }
+        try {
+            await page.exposeFunction(name, fn);
+            return;
+        } catch (error) {
+            const retryable = /Target closed/.test(String(error && error.message));
+            if (!retryable || attempt === maxAttempts) throw error;
+            await new Promise((resolve) => setTimeout(resolve, 250));
+        }
     }
-    await page.exposeFunction(name, fn);
 }
 
