+    /**
+     * WhatsApp Web loads some modules lazily: until the bundle of the screen that uses them is loaded,
+     * window.require(name) answers undefined (or null). Loads the bundle through its Loadable and
+     * answers the module. When it is still missing it throws an error that names the module and the
+     * WhatsApp Web version, so the cause reaches the logs instead of a generic failure.
+     * @param {string} name The module the library needs
+     * @param {string} [loadable] The module whose requireBundle() loads it, when one is known
+     * @returns {Promise<Object>} The module
+     */
+    window.WWebJS.requireLazyModule = async (name, loadable) => {
+        let module = window.require(name);
+        let loadError;
+        if (!module && loadable) {
+            const bundle = window.require(loadable);
+            if (bundle && typeof bundle.requireBundle === 'function') {
+                try {
+                    await bundle.requireBundle();
+                } catch (error) {
+                    loadError = error;
+                }
+            }
+            module = window.require(name);
+        }
+        if (!module) {
+            const build =
+                (window.Debug && window.Debug.VERSION) || 'unknown';
+            const why = loadable
+                ? loadError
+                    ? `its bundle ${loadable} failed to load: ${String(
+                          (loadError && loadError.message) || loadError,
+                      ).slice(0, 200)}`
+                    : `its bundle ${loadable} did not load it`
+                : 'no bundle is known to load it';
+            throw new Error(
+                `[lazy-module] ${name} is not available in WhatsApp Web ${build} (${why})`,
+            );
+        }
+        return module;
+    };
