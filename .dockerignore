.git
.github
.husky
.claude
.vscode
.code-review-graph

# Credentials and secrets, at any depth: a pattern without **/ only matches in the root of the
# context, and the image copies whole folders such as src/
**/.env
**/.env.*
!**/.env.example
**/.wwebjs_auth
**/.wwebjs_cache
**/secrets
**/.npmrc
**/*.pem
**/*.key

node_modules
dist
# Generated inside the image by `pnpm db:generate`, never taken from the local checkout
src/generated
coverage
docs
deploy
tests
scripts
*.md
*.log
